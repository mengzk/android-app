<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pageBg"
    android:paddingHorizontal="@dimen/dimen_24">

    <TextView
        android:id="@+id/main_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="@dimen/dimen_46"
        android:background="@drawable/bg_box"
        android:padding="@dimen/dimen_16"
        android:text="@string/home_hallo"
        android:textColor="@color/white"
        android:textSize="@dimen/size_16" />

    <ImageView
        android:id="@+id/main_logo"
        android:layout_width="@dimen/dimen_160"
        android:layout_height="@dimen/dimen_120"
        android:layout_gravity="center"
        android:src="@mipmap/robot" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/main_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <Button
        android:id="@+id/goto_login"
        style="@style/SingleButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center|bottom"
        android:layout_marginBottom="@dimen/dimen_36"
        android:text="@string/start_detection" />

</FrameLayout>
<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data></data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dimen_24">

        <include
            android:id="@+id/top_view3"
            layout="@layout/page_top" />

        <LinearLayout
            android:id="@+id/pulse_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/dimen_14">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dimen_64"
                android:src="@mipmap/pulse" />

            <TextView
                android:id="@+id/pulse_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_12"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="@dimen/size_16"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pulse_progress_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <com.ql.health.custom.widget.CircularProgress
                android:id="@+id/circular_progress"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                app:max="100"
                app:progress="0" />

            <TextView
                android:id="@+id/pulse_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                android:text="@string/pulse_desc"
                android:textColor="@color/subtitle"
                android:textSize="@dimen/size_13" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pulse_status_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/pulse_status_ic"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dimen_24" />

            <TextView
                android:id="@+id/pulse_link_fail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_err"
                android:paddingHorizontal="@dimen/dimen_8"
                android:paddingVertical="@dimen/dimen_4"
                android:text="@string/link_fail"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pulse_link_ok"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ok"
                android:paddingHorizontal="@dimen/dimen_8"
                android:paddingVertical="@dimen/dimen_4"
                android:text="@string/link_success"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/pulse_link_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_36"
            android:layout_marginHorizontal="@dimen/dimen_24"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pulse_cut"
                style="@style/PulseBtn"
                android:layout_width="@dimen/dimen_120"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_line"
                android:text="@string/device_cut"
                android:textColor="@color/white" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/pulse_link"
                style="@style/PulseBtn"
                android:layout_width="@dimen/dimen_120"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_fill"
                android:text="@string/device_link" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pulse_check_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_36"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/pulse_left"
                style="@style/PulseBtn"
                android:layout_width="@dimen/dimen_120"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_fill"
                android:text="@string/pulse_start"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/pulse_right"
                style="@style/PulseBtn"
                android:layout_width="@dimen/dimen_120"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_fill"
                android:text="@string/pulse_start2" />
        </LinearLayout>
    </LinearLayout>
</layout>